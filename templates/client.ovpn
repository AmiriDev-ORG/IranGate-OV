client
dev tun
proto {{.Protocol}}
remote {{.ServerIP}} {{.Port}}
resolv-retry infinite
nobind
persist-key
persist-tun

# Security
remote-cert-tls server
auth SHA512
cipher {{.Cipher}}
verb 3

# Compression
comp-lzo

# Certificate
<ca>
{{.CACert}}
</ca>
<cert>
{{.ClientCert}}
</cert>
<key>
{{.ClientKey}}
</key>
<tls-crypt>
{{.TLSCrypt}}
</tls-crypt>

# Additional settings
{{if .IPv6Enabled}}
proto-force {{.Protocol}}6
{{end}}

{{if .MTU}}
tun-mtu {{.MTU}}
{{end}}

# Custom DNS servers
{{range .DNS}}
dhcp-option DNS {{.}}
{{end}}